    {
      "id": 1,
      "type": "stat",
      "title": "Cheapest E5",
      "description": "Lowest super unleaded price in selected region",
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 145 },
              { "color": "red", "value": 155 }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"fueltrack\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"fuel_price\")\n  |> filter(fn: (r) => r._field == \"price_pence\")\n  |> filter(fn: (r) => r.fuel_type == \"E5\")\n  |> filter(fn: (r) => r.region == \"${region}\" or \"${region}\" == \"All\")\n  |> filter(fn: (r) => r.brand == \"${brand}\" or \"${brand}\" == \"All\")\n  |> last()\n  |> group()\n  |> min()\n  |> map(fn: (r) => ({r with _field: r.station_name}))"
        }
      ]
    },
