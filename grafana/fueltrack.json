          "query": "from(bucket: \"fueltrack\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"fuel_price\")\n  |> filter(fn: (r) => r._field == \"price_pence\")\n  |> filter(fn: (r) => r.fuel_type == \"${fuel_type}\" or \"${fuel_type}\" == \"All\")\n  |> filter(fn: (r) => r.brand == \"${brand}\" or \"${brand}\" == \"All\")\n  |> last()\n  |> group(columns: [\"region\"])\n  |> mean()\n  |> group()\n  |> sort(columns: [\"_value\"], desc: false)"
        }
      ]
    }
  ],
