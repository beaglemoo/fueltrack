{
  "uid": "fueltrack",
  "title": "FuelTrack - UK Fuel Prices",
  "tags": ["fueltrack", "fuel", "prices"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1h",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "query",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "allValue": "All",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "datasource": {
          "type": "influxdb",
          "uid": "InfluxDB"
        },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(\n  bucket: \"fueltrack\",\n  tag: \"region\",\n  predicate: (r) => r._measurement == \"fuel_price\"\n)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "fuel_type",
        "type": "query",
        "label": "Fuel Type",
        "multi": true,
        "includeAll": true,
