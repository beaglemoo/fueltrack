        },
        "datasource": {
          "type": "influxdb",
          "uid": "InfluxDB"
        },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(\n  bucket: \"fueltrack\",\n  tag: \"fuel_type\",\n  predicate: (r) => r._measurement == \"fuel_price\"\n)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "brand",
        "type": "query",
        "label": "Brand",
        "multi": true,
        "includeAll": true,
        "allValue": "All",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "datasource": {
          "type": "influxdb",
          "uid": "InfluxDB"
        },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(\n  bucket: \"fueltrack\",\n  tag: \"brand\",\n  predicate: (r) => r._measurement == \"fuel_price\"\n)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
